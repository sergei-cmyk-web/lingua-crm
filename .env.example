# Database (для локальной разработки без Docker — обычный connection string)
DATABASE_URL=postgresql://crm_user:crm_password@localhost:5432/crm_db

# Redis (для локальной разработки без Docker)
REDIS_URL=redis://localhost:6379

# ── Только для docker-compose.yml (prod) — DATABASE_URL/REDIS_URL выше игнорируются,
#    compose вычисляет их сам из этих переменных. Пароли — ТОЛЬКО через `openssl rand -hex 24`,
#    не base64: символы /+= ломают парсинг connection URL.
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=
POSTGRES_DB=crm_db
REDIS_PASSWORD=
# Нужен, только если сборка падает на "prisma generate" из-за недоступности
# binaries.prisma.sh (типично для российских IP):
# PRISMA_ENGINES_MIRROR=https://registry.npmmirror.com/-/binary/prisma

# Auth
JWT_SECRET=change-me-to-random-64-char-string
JWT_REFRESH_SECRET=change-me-refresh-to-random-64-char-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# WazzUp
WAZZUP_API_KEY=
WAZZUP_CHANNEL_ID=
WAZZUP_WEBHOOK_SECRET=

# UIS (ЮИС / Колл-трекинг)
UIS_API_KEY=
UIS_API_SECRET=
UIS_VIRTUAL_NUMBER=

# Только для локальной разработки без настроенных WAZZUP_WEBHOOK_SECRET/UIS_API_KEY: по умолчанию
# (переменная не задана) вебхуки без секрета отклоняются (fail-closed) независимо от NODE_ENV.
# Установить true, только если осознанно тестируешь вебхуки локально без секрета. НЕ включать на проде.
ALLOW_UNVERIFIED_WEBHOOKS=

# Диагностика WazzUp: true — писать в лог полные тела вебхуков и исходящих запросов (телефоны, тексты
# переписки). По умолчанию выключено; включать временно для разбора формата, не держать на проде.
LOG_WAZZUP_BODY=

# Email-канал: S3-совместимое хранилище вложений (Yandex Object Storage / R2 / MinIO — любой провайдер).
# Без этих переменных письма отправляются/принимаются, но вложения не сохраняются.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Интервал опроса IMAP всех активных почтовых ящиков, мс (по умолчанию 120000)
EMAIL_POLL_INTERVAL_MS=120000

# App
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
PORT=4000
NODE_ENV=development

# CORS — обязателен в production (whitelist, через запятую). Без него API не стартует.
CORS_ORIGIN=http://localhost:3000

# Таймзона школы — в ней рендерятся {дата}/{время} в напоминаниях о пробных уроках.
# Сервер обычно живёт в UTC — без этого клиент получит неверное время.
SCHOOL_TZ=Europe/Moscow

# Демо-данные (seed). Создаются ТОЛЬКО если SEED_DEMO=true И задан пароль.
# Не включать на реальном проде.
SEED_DEMO=true
SEED_DEMO_PASSWORD=change-me

# ── Демо-режим — запускается ЛОКАЛЬНО через `npm run dev:demo`, см. docs/demo-stand.md.
# Сами флаги здесь задавать не нужно (dev:demo подставляет их сам), на проде — оставить пустыми:
# DEMO_MODE=true              — бэкенд: блокирует мутации (demoGuard), отключает фоновые воркеры
# NEXT_PUBLIC_DEMO_MODE=true  — фронтенд: клиентский перехват мутаций + авто-логин
# Логин/пароль демо-пользователя (дефолт demo@example.com / demo12345). Читают И фронтенд,
# И prisma/seed-demo.ts — менять до засева, иначе авто-логин упрётся в 401.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
